# ─── Abhängigkeiten ────────────────────────────────────────────────────────
/vendor
/node_modules

# ─── Build-Artefakte ───────────────────────────────────────────────────────
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/storage/*.key
/storage/pail

# ─── Logs & Laravel-Framework-Caches (Inhalt ignorieren, Struktur behalten) ─
*.log
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/bootstrap/cache/*.php

# ─── Environment / Secrets ─────────────────────────────────────────────────
.env
.env.backup
.env.production
.env.*.local
.env.local
/auth.json

# ─── Test-/Tool-Caches ─────────────────────────────────────────────────────
.phpunit.cache
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
.php-cs-fixer.cache
.psalm/
.phpstan/
clover.xml
coverage/

# ─── Lokale DB-Snapshots ───────────────────────────────────────────────────
/database/database.sqlite
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sql.gz
backup-*.sql
mysqldump-*.sql

# ─── Editor / IDE ──────────────────────────────────────────────────────────
/.idea
/.vscode
/.fleet
/.zed
/.nova
/.cursor/
/.codex
/.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# ─── Claude / KI-Tooling ───────────────────────────────────────────────────
/.claude

# ─── Lokale Hilfs-/Probe-Skripte (waehrend Entwicklung) ────────────────────
/probe_*.php
/seed_bulk.php
/seed_distributions.php
/setup_db.php
/verify*.php
/probe.php

# ─── Homestead / Vagrant ───────────────────────────────────────────────────
Homestead.json
Homestead.yaml
.vagrant/

# ─── Docker (lokale Override-Datei, optionaler Compose-Override) ───────────
docker-compose.override.yml
docker-compose.*.local.yml

# ─── Betriebssystem-Krempel ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── Diverses ──────────────────────────────────────────────────────────────
*.bak
*.swp
*.swo
*~
